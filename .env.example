# Neon PostgreSQL connection strings
# Get yours at https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Meta (Facebook/Instagram) App credentials
# Create an app at https://developers.facebook.com
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Your deployed app URL (no trailing slash)
NEXT_PUBLIC_APP_URL="https://aplicativo-marketing-cdr.vercel.app"

# TikTok App credentials
# Create an app at https://developers.tiktok.com
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"

# Secret for protecting cron endpoints (optional)
CRON_SECRET="generate_a_random_secret_here"
